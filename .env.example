# Copy to .env (tooling/scripts/init-env.ps1 does this with random values). NEVER commit .env.
AEGIS_DB_PASSWORD=change-me-local-only
AEGIS_DB_PORT=5433
AEGIS_API_PORT=8080
AEGIS_WEB_PORT=5173
# Password for the seeded DEV users (admin, lead, analyst, engineer, viewer). If empty the API generates
# a random one at first start and logs it once.
AEGIS_DEV_PASSWORD=
# Optional AI provider: none | mock | ollama. Disabled by default.
AEGIS_AI_PROVIDER=none
AEGIS_AI_OLLAMA_URL=http://127.0.0.1:11434
AEGIS_AI_MODEL=
